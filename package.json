{
  "name": "cxconnect-playwright-js",
  "version": "1.0.0",
  "description": "Production-ready Playwright Automation Framework in JavaScript for MERN App",
  "scripts": {
    "test": "playwright test",

    "── PASSWORD LOGIN ──────────────────────────────────────────": "",
    "test:login:password": "cross-env TEST_ENV=uat playwright test tests/auth/password-login.spec.js",
    "test:login:password:headed": "cross-env TEST_ENV=uat playwright test tests/auth/password-login.spec.js --headed",
    "test:login:password:chromium": "cross-env TEST_ENV=uat playwright test tests/auth/password-login.spec.js --project=chromium",

    "── OTP LOGIN ───────────────────────────────────────────────": "",
    "test:login:otp": "cross-env TEST_ENV=uat playwright test tests/auth/otp-login.spec.js",
    "test:login:otp:headed": "cross-env TEST_ENV=uat playwright test tests/auth/otp-login.spec.js --headed",
    "test:login:otp:chromium": "cross-env TEST_ENV=uat playwright test tests/auth/otp-login.spec.js --project=chromium",

    "── UNIFIED LOGIN (env-driven) ──────────────────────────────": "",
    "test:uat:password": "cross-env TEST_ENV=uat LOGIN_TYPE=password playwright test tests/auth/login.spec.js",
    "test:uat:otp": "cross-env TEST_ENV=uat LOGIN_TYPE=otp playwright test tests/auth/login.spec.js",
    "test:qa:password": "cross-env TEST_ENV=qa LOGIN_TYPE=password playwright test tests/auth/login.spec.js",
    "test:qa:otp": "cross-env TEST_ENV=qa LOGIN_TYPE=otp playwright test tests/auth/login.spec.js",
    "test:prod:password": "cross-env TEST_ENV=prod LOGIN_TYPE=password playwright test tests/auth/login.spec.js",
    "test:prod:otp": "cross-env TEST_ENV=prod LOGIN_TYPE=otp playwright test tests/auth/login.spec.js",

    "── SMOKE TESTS ─────────────────────────────────────────────": "",
    "test:smoke:password": "cross-env TEST_ENV=uat playwright test tests/auth/password-login.spec.js --grep @smoke",
    "test:smoke:otp": "cross-env TEST_ENV=uat playwright test tests/auth/otp-login.spec.js --grep @smoke",

    "── AUTHENTICATED TESTS ─────────────────────────────────────": "",
    "test:authenticated": "cross-env TEST_ENV=uat playwright test --project=chromium-authenticated",
    "test:authenticated:headed": "cross-env TEST_ENV=uat playwright test --project=chromium-authenticated --headed",
    "test:authenticated:ui": "cross-env TEST_ENV=uat playwright test --project=chromium-authenticated --ui",

    "── CAMPAIGN TESTS ──────────────────────────────────────────": "",
    "test:campaign": "cross-env TEST_ENV=uat playwright test tests/campaign/campaign.spec.js --project=chromium --workers=1",
    "test:campaign:headed": "cross-env TEST_ENV=uat playwright test tests/campaign/campaign.spec.js --project=chromium --headed --workers=1",
    "test:campaign:ui": "cross-env TEST_ENV=uat playwright test tests/campaign/campaign.spec.js --project=chromium --ui --workers=1",

    "── INBOUND CAMPAIGN TESTS ──────────────────────────────────": "",
    "test:campaign:inbound": "cross-env TEST_ENV=uat playwright test tests/campaign/inbound-campaign.spec.js --project=chromium --workers=1",
    "test:campaign:inbound:headed": "cross-env TEST_ENV=uat playwright test tests/campaign/inbound-campaign.spec.js --project=chromium --headed --workers=1",
    "test:campaign:inbound:ui": "cross-env TEST_ENV=uat playwright test tests/campaign/inbound-campaign.spec.js --project=chromium --ui --workers=1",
    "test:campaign:inbound:smoke": "cross-env TEST_ENV=uat playwright test tests/campaign/inbound-campaign.spec.js --project=chromium --grep @smoke --workers=1",

    "── UTILS ───────────────────────────────────────────────────": "",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5"
  }
}
