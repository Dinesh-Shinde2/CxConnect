# ============================================================
# Environment Configuration Template
# ============================================================

TEST_ENV=uat
BASE_URL=https://uat.ishancxconnect.com

# Active Persona configuration (options: tenant_admin | admin | supervisor | agent)
# Change USER_ROLE to switch which user persona runs the tests.
USER_ROLE=admin

# Persona Credentials
TENANT_ADMIN_USER_ID=your_tenant_admin_id
TENANT_ADMIN_USER_PASSWORD=your_tenant_admin_password

ADMIN_USER_ID=your_admin_id
ADMIN_USER_PASSWORD=your_admin_password

SUPERVISOR_USER_ID=your_supervisor_id
SUPERVISOR_USER_PASSWORD=your_supervisor_password

AGENT_USER_ID=your_agent_id
AGENT_USER_PASSWORD=your_agent_password

# Legacy Credentials (fallback)
USER_ID=your_username
USER_PASSWORD=your_password

# Credentials for OTP Login Flow
ADMIN_EMAIL=your_email@yopmail.com

# API and WebSocket URLs
API_BASE_URL=https://uat.ishancxconnect.com/api
WS_URL=wss://uat.ishancxconnect.com/ws
